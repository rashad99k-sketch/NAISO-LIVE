# GGP / JGB environment template.
# Copy this file to `.env` next to ggpbot.py and fill in your own values.
# NEVER commit or ship the real `.env` (it holds live credentials).

# ---- Trading mode (fail-safe defaults) ----
# PAPER is the default. LIVE requires ALL THREE: PAPER_MODE=false,
# ENABLE_LIVE_TRADING=true and valid BingX credentials.
PAPER_MODE=true
ENABLE_LIVE_TRADING=false

# ---- BingX API credentials (leave empty in the template) ----
BINGX_API_KEY=
BINGX_API_SECRET=

# ---- Optional Telegram alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Market / strategy (strategy logic itself is not configurable) ----
SYMBOL=BTC/USDT
INTERVAL=15m

# ---- Fixed risk policy ----
# Leverage is FIXED at 20x; any other value is rejected and forced back to 20.
LEVERAGE=20
# Stop-risk budget as a percentage of each trade TARGET MARGIN (not wallet balance).
# Example: 20% allocation x 10% trade risk = 2% of available balance at risk, before costs.
MAX_TRADE_RISK_PCT=10.0
# Extra adverse price-move buffer (percentage points) used in risk sizing.
STOP_EXECUTION_BUFFER_PCT=0.05

# ---- Sniper V2 (signal-only engine; order execution uses the unified GGP gateway) ----
SNIPER_V2_ENABLED=true
SNIPER_V2_SCAN_INTERVAL=15
SNIPER_V2_MAX_SYMBOLS=8
SNIPER_V2_PIVOT_LOOKBACK=3
SNIPER_V2_ZONE_ATR_WIDTH=0.50
SNIPER_V2_SL_ATR_BUFFER=0.40
SNIPER_V2_ZONE_MAX_AGE_SEC=14400
SNIPER_V2_CONFIRMATION_WINDOW_BARS=3
SNIPER_V2_MAX_ENTRY_DISTANCE_ATR=0.75

# ---- Persistence ----
# Keep this path stable so restarts reuse the same SQLite trade journal.
TRADE_JOURNAL_PATH=data/ggp_trade_journal.sqlite3

# ---- Recovery retry cadence (seconds) ----
RECOVERY_RETRY_INTERVAL_SEC=20

# ---- Dashboard ports ----
# Leave PORT empty on Windows (local 8000/8080 are used). Hosted platforms set PORT.
PORT=
DASHBOARD_LOCAL_PORTS=8000,8080
DASHBOARD_BIND_HOST=127.0.0.1
